{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Salt Player",
  "version": "0.1.0-alpha",
  "identifier": "com.saltplayer.linux",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Salt Player",
        "width": 1024,
        "height": 680,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": ["icons/icon.png"],
    "shortDescription": "Salt Player for Linux",
    "longDescription": "A local music player for Ubuntu 24.04."
  }
}
